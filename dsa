</style>""",
           '<defs><linearGradient id="fl" x1="0" y1="1" x2="0" y2="0">'
           '<stop offset="0" stop-color="#ef4444"/><stop offset=".6" stop-color="#f97316"/><stop offset="1" stop-color="#fbbf24"/>'
           '</linearGradient></defs>',
           f'<rect x=".5" y=".5" width="{W - 1}" height="{H - 1}" rx="14" fill="{c["bg"]}" stroke="{c["line"]}"/>']

    # Streak: flame (grey when the streak is broken) + big number.
    alive = streak > 0
    fill, core = ("url(#fl)", "#fde68a") if alive else (c["line"], c["card"])
    out.append(f'<g transform="translate(70 112)"><path class="flame" d="{FLAME}" fill="{fill}"/>'
               f'<path class="core" d="{FLAME_CORE}" fill="{core}"/>')
    if alive:
        for i, (x, dx) in enumerate([(-10, "-8px"), (6, "10px"), (0, "-2px"), (12, "4px"), (-14, "-12px")]):
            out.append(f'<circle class="ember" cx="{x}" cy="-20" r="{2 + i % 2}" fill="#fbbf24" '
                       f'style="--dx:{dx};animation-delay:{i * .45:.2f}s"/>')
    out.append("</g>")
    note = ("Today counted ✓" if today_n >= GOAL else
            f"{GOAL - today_n} more today to keep it" if alive else f"Solve {GOAL} in a day to start one")
    out.append(f'<g class="in" style="animation-delay:.1s"><text x="112" y="104" font-size="54" font-weight="800">{streak}</text>'
               f'<text x="114" y="128" font-size="15" font-weight="600">day streak</text>'
               f'<text x="114" y="148" font-size="12" class="muted">{esc(note)}</text></g>')
    out.append(f'<text x="28" y="196" class="muted k in" style="animation-delay:.2s">DSA Tracker · {GOAL}+ a day</text>')

    # Stats column.
    split = [(d, sum(p["difficulty"] == d for p in problems)) for d in ("Easy", "Medium", "Hard")]
    stats = [("Total solved", len(problems)), ("Longest streak", f"{longest} day{'s' * (longest != 1)}"),
             ("Today", f"{today_n} / {GOAL}")]
    for i, (label, value) in enumerate(stats):
        y = 54 + i * 56
        out.append(f'<g class="in" style="animation-delay:{.25 + i * .12:.2f}s">'
                   f'<text x="300" y="{y}" class="muted k">{label}</text>'
                   f'<text x="300" y="{y + 26}" font-size="22" font-weight="700">{esc(value)}</text></g>')
    # Difficulty split bar under "Total solved".
    x, total = 390, max(1, len(problems))
    for d, n in split:
        if n:
            w = 110 * n / total
            out.append(f'<rect class="in" style="animation-delay:.5s" x="{x:.1f}" y="66" width="{w:.1f}" height="8" '
                       f'rx="2" fill="{c[d]}"><title>{n} {d}</title></rect>')
            x += w
    # Today progress bar.
    pct = min(1, today_n / GOAL)
    out.append(f'<rect x="390" y="178" width="110" height="8" rx="4" fill="{c["heat"][0]}"/>')
    if pct:
        out.append(f'<rect x="390" y="178" width="{110 * pct:.1f}" height="8" rx="4" '
                   f'fill="{c["Easy"] if pct >= 1 else "#f97316"}">'
                   f'<animate attributeName="width" from="0" to="{110 * pct:.1f}" dur="1s" begin=".6s" fill="freeze" '
                   f'calcMode="spline" keySplines=".2 .8 .2 1"/></rect>')

    # Heatmap: CARD_WEEKS columns, Monday-first rows, ending this week; columns pop in left to right.
    cell, gap, hx, hy = 15, 3, 540, 44
    start = today - timedelta(days=today.weekday() + (CARD_WEEKS - 1) * 7)
    out.append(f'<text x="{hx}" y="{hy - 12}" class="muted k in" style="animation-delay:.2s">Last {CARD_WEEKS} weeks</text>')
    for i in range(CARD_WEEKS * 7):
        d = start + timedelta(days=i)
        if d > today:
            continue
        col, row = divmod(i, 7)
        n = len(by_day.get(d.isoformat(), []))
        cls = "pop goal" if n >= GOAL else "pop"
        stroke = ' stroke="#f97316" stroke-width="1.5"' if n >= GOAL else ""
        if d == today:
            stroke = f' stroke="{c["text"]}" stroke-width="1.5"'
        out.append(f'<rect class="{cls}" style="animation-delay:{.3 + col * .04:.2f}s" x="{hx + col * (cell + gap)}" '
                   f'y="{hy + row * (cell + gap)}" width="{cell}" height="{cell}" rx="3" fill="{c["heat"][min(4, n)]}"{stroke}>'
                   f'<title>{d:%b %-d}: {n} solved</title></rect>')

    # Latest problems ticker.
    latest = sorted(problems, key=lambda p: (p["date"], p["title"]), reverse=True)[:4]
    out.append(f'<line x1="24" y1="212" x2="{W - 24}" y2="212" stroke="{c["line"]}"/>')
    out.append(f'<text x="28" y="235" class="muted k in" style="animation-delay:1s">Latest</text>')
    x = 96
    for i, p in enumerate(latest):
        title = p["title"] if len(p["title"]) <= 26 else p["title"][:24] + "…"
        w = 22 + 7 * len(title)
        if x + w > W - 24:
            break
        color = c.get(p["difficulty"], c["muted"])
        out.append(f'<g class="in" style="animation-delay:{1.1 + i * .15:.2f}s">'
                   f'<rect x="{x}" y="220" width="{w}" height="22" rx="11" fill="{c["card"]}" stroke="{c["line"]}"/>'
                   f'<circle cx="{x + 11}" cy="231" r="3.5" fill="{color}"/>'
                   f'<text x="{x + 19}" y="235" font-size="12">{esc(title)}</text></g>')
        x += w + 8
    out.append("</svg>")
    return "\n".join(out)


def cmd_site(args):
    problems = []
    for path in sorted(SOLUTIONS.glob("*/*.swift")):
        if path.name.startswith("_"):
            continue
        day = finished_date(path)
        if not day:
            continue
        slug = path.stem
        problems.append({
            "slug": slug,
            "category": path.parent.name,
            "date": day,
            "path": str(path.relative_to(ROOT)),
            **parse_header(path, slug),
        })
    data = {"repo": repo_url(), "problems": problems}
    page = (ROOT / "tracker" / "index.html").read_text()
    page = page.replace("/*__DATA__*/null", json.dumps(data).replace("</", "<\\/"))
    out = ROOT / "_site" / "index.html"
    out.parent.mkdir(exist_ok=True)
    out.write_text(page)
    shutil.copytree(ROOT / "tracker" / "assets", out.parent / "assets", dirs_exist_ok=True)
    for theme in CARD_THEMES:
        (out.parent / f"card-{theme}.svg").write_text(render_card(problems, theme))
    categories = len({p["category"] for p in problems})
    print(f"Wrote {out.relative_to(ROOT)}: {len(problems)} problems in {categories} categories")
    if args.open:
        subprocess.call(["open", str(out)])


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)

    def add_filters(p):
        p.add_argument("company")
        p.add_argument("-p", "--period", choices=PERIODS, default="all")
        p.add_argument("-d", "--difficulty", choices=["easy", "medium", "hard"])
        p.add_argument("-t", "--topic")

    p = sub.add_parser("companies"); p.add_argument("query", nargs="?"); p.set_defaults(func=cmd_companies)
    p = sub.add_parser("list"); add_filters(p); p.set_defaults(func=cmd_list)
    p = sub.add_parser("pick"); add_filters(p)
    p.add_argument("-n", type=int, default=1, help="how many problems (default 1)")
    p.add_argument("-r", "--random", action="store_true", help="random instead of most frequent")
    p.set_defaults(func=cmd_pick)
    p = sub.add_parser("new"); p.add_argument("problem", help="LeetCode link or slug")
    p.add_argument("--dir", help="subfolder of solutions/, e.g. Hashmap")
    p.add_argument("--force", action="store_true", help="overwrite even if you've written code")
    p.set_defaults(func=cmd_new)
    p = sub.add_parser("open"); p.add_argument("slug", nargs="?"); p.set_defaults(func=cmd_open)
    p = sub.add_parser("regen"); p.add_argument("slugs", nargs="*")
    p.add_argument("--force", action="store_true", help="overwrite even if you've written code")
    p.set_defaults(func=cmd_regen)
    p = sub.add_parser("done"); p.add_argument("slug"); p.set_defaults(func=cmd_done)
    p = sub.add_parser("undo"); p.add_argument("slug"); p.set_defaults(func=cmd_undo)
    p = sub.add_parser("status"); p.add_argument("company", nargs="?"); p.set_defaults(func=cmd_status)
    p = sub.add_parser("site"); p.add_argument("--open", action="store_true", help="open the page in your browser")
    p.set_defaults(func=cmd_site)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
