def streak_stats(problems, today):
    """(current streak, longest streak, solved today) with the tracker page's rules."""
    from datetime import timedelta
    by_day = {}
    for p in problems:
        by_day[p["date"]] = by_day.get(p["date"], 0) + 1
    count = lambda d: by_day.get(d.isoformat(), 0)
    cursor = today if count(today) >= GOAL else today - timedelta(days=1)
    streak = 0
    while count(cursor) >= GOAL:
        streak += 1
        cursor -= timedelta(days=1)
    longest = run = 0
    prev = None
    for d in sorted(date.fromisoformat(k) for k, n in by_day.items() if n >= GOAL):
        run = run + 1 if prev and d - prev == timedelta(days=1) else 1
        longest, prev = max(longest, run), d
    return streak, longest, count(today)


